# PlaudBlender Configuration
# ========================

# === PLAUD API (Required) ===
# Get these from: https://platform.plaud.ai/developer/portal
PLAUD_CLIENT_ID=your_client_id_here
PLAUD_CLIENT_SECRET=your_client_secret_here
PLAUD_REDIRECT_URI=http://localhost:8080/callback

# === VECTOR DATABASE ===
# Qdrant is the primary vector store (local-first, granular temporal search)

# --- Qdrant (Recommended - local, free, granular) ---
# Local Docker: docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=chronos_events
QDRANT_TIMEOUT_SECONDS=5
# For Qdrant Cloud (optional):
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key

# --- Search tuning (optional) ---
# Reranking (when supported by your active vector provider)
VECTOR_RERANK_ENABLED=false
VECTOR_RERANK_MODEL=bge-reranker-v2-m3

# Hybrid search (dense + sparse)
VECTOR_HYBRID_ENABLED=false
VECTOR_HYBRID_ALPHA=0.5

# --- SSL (optional, macOS/Homebrew edge-case) ---
# If your Python SSL trust store is broken, you can point to a known CA bundle.
# SSL_CERT_FILE=/opt/homebrew/etc/openssl@3/cert.pem
# SSL_CERT_DIR=/opt/homebrew/etc/openssl@3/certs

# === PLAUD WEBHOOK (Optional - for async notifications) ===
# PLAUD_WEBHOOK_SECRET=your_webhook_secret
# PLAUD_WEBHOOK_URL=https://your-server.com/webhook/plaud
PLAUD_DEFAULT_LANGUAGE=en
PLAUD_ENABLE_DIARIZATION=1
PLAUD_WORKFLOW_TIMEOUT=600

# === AI PROCESSING (Required for knowledge graph features) ===
# Google Gemini - https://ai.google.dev/
GEMINI_API_KEY=your_gemini_key_here

# Gemini model overrides (optional, defaults shown)
# CHRONOS_CLEANING_MODEL=gemini-3-flash-preview
# CHRONOS_ANALYST_MODEL=gemini-3.1-pro-preview
# CHRONOS_EMBEDDING_MODEL=gemini-embedding-2-preview
# CHRONOS_EMBEDDING_DIM=768
# GEMINI_API_VERSION=v1beta

# OpenAI (optional — enables RAG responses via Responses API, preferred over Gemini for ask_chronos)
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-5.4
# OPENAI_TEMPERATURE=0.7

# Notion (optional - enables direct Notion sync)
# NOTION_TOKEN=your_notion_token_here
# NOTION_DATABASE_ID=your_notion_database_id_here
