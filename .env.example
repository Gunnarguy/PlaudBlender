# PlaudBlender Configuration
# ========================

# === PLAUD API (Required) ===
# Get these from: https://platform.plaud.ai/developer/portal
PLAUD_CLIENT_ID=your_client_id_here
PLAUD_CLIENT_SECRET=your_client_secret_here
PLAUD_REDIRECT_URI=http://localhost:8050/auth/plaud/callback

# === PLAUD Embedded (Optional, backend only) ===
# These credentials belong only on the Chronos backend. Never put the secret
# or API key in the iOS target, Info.plist, xcconfig committed to Git, or logs.
# PLAUD_EMBEDDED_CLIENT_ID=your_embedded_client_id
# PLAUD_EMBEDDED_SECRET_KEY=your_embedded_secret_key
# PLAUD_EMBEDDED_API_KEY=your_embedded_api_key
# PLAUD_EMBEDDED_REGION=us

# === VECTOR DATABASE ===
# Qdrant is the primary vector store (local-first, granular temporal search)

# --- Qdrant (Recommended - local, free, granular) ---
# Local Docker: docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=chronos_events
QDRANT_TIMEOUT_SECONDS=5
# For Qdrant Cloud (optional):
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key

# --- Search tuning (optional) ---
# Reranking (when supported by your active vector provider)
VECTOR_RERANK_ENABLED=false
VECTOR_RERANK_MODEL=bge-reranker-v2-m3

# Hybrid search (dense + sparse)
VECTOR_HYBRID_ENABLED=false
VECTOR_HYBRID_ALPHA=0.5

# --- SSL (optional, macOS/Homebrew edge-case) ---
# If your Python SSL trust store is broken, you can point to a known CA bundle.
# SSL_CERT_FILE=/opt/homebrew/etc/openssl@3/cert.pem
# SSL_CERT_DIR=/opt/homebrew/etc/openssl@3/certs

# === PLAUD WEBHOOK (Optional - for async notifications) ===
# PLAUD_WEBHOOK_SECRET=your_webhook_secret
# PLAUD_WEBHOOK_URL=https://your-server.com/webhook/plaud
PLAUD_DEFAULT_LANGUAGE=en
PLAUD_ENABLE_DIARIZATION=1
PLAUD_WORKFLOW_TIMEOUT=600

# === AI PROCESSING (Required for Ask Chronos and extraction) ===
# Gemini is the default Chronos path. Use a dedicated Chronos key so this repo
# does not consume quota from any other Gemini-heavy project you run.
CHRONOS_GEMINI_API_KEY=your_chronos_gemini_key_here
CHRONOS_PROCESSING_PROVIDER=gemini
CHRONOS_CLEANING_MODEL=gemini-2.5-flash
CHRONOS_ANALYST_MODEL=gemini-2.5-flash
CHRONOS_EMBEDDING_MODEL=gemini-embedding-2
CHRONOS_EMBEDDING_DIM=768
GEMINI_BILLING_TIER=free

# Optional: explicitly allow Chronos to reuse a shared GEMINI_API_KEY instead.
# Leave this off if you want PlaudBlender isolated from other Gemini usage.
# CHRONOS_ALLOW_SHARED_GEMINI_KEY=1
# GEMINI_API_KEY=your_shared_gemini_key_here

# Optional OpenAI paid fallback / RAG path
# CHRONOS_OPENAI_ENABLED=0
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-5.5
# OPENAI_TEMPERATURE=0.7

# Fully local/no-cloud quota mode for constrained Pi fallback:
# CHRONOS_PROCESSING_PROVIDER=local
# CHRONOS_EMBEDDING_MODEL=nomic-embed-text
# CHRONOS_EMBEDDING_DIM=768

# Optional local Ollama/llama.cpp sidecar for degraded short tasks on the Pi.
# Keep this localhost-only; use tiny models for helper tasks, not full-day extraction.
CHRONOS_LOCAL_LLM_ENABLED=0
CHRONOS_LOCAL_LLM_PROVIDER=ollama
CHRONOS_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
CHRONOS_LOCAL_LLM_MODEL=qwen2.5:0.5b
CHRONOS_LOCAL_LLM_MAX_CONTEXT=4096
CHRONOS_LOCAL_LLM_ALLOWED_TASKS=json_repair,entity_extract,classify,ask
CHRONOS_LOCAL_EMBED_BATCH_SIZE=4
CHRONOS_LOCAL_EMBED_TIMEOUT_SECONDS=300
CHRONOS_OLLAMA_KEEP_ALIVE=0s
CHRONOS_INDEX_EVENTS_PER_LIMIT=1

# Auto-sync safety knobs for small Pi-class hosts.
CHRONOS_POLL_INTERVAL=1800
CHRONOS_AUTOSYNC_PROCESS_LIMIT=3
CHRONOS_AUTOSYNC_INDEX_LIMIT=4
CHRONOS_AUTOSYNC_INDEX_TIMEOUT=900
CHRONOS_AUTOSYNC_GRAPH_LIMIT=3
CHRONOS_AUTOSYNC_MAX_LOAD_AVG=3.5
CHRONOS_AUTOSYNC_MIN_AVAILABLE_MB=700
CHRONOS_AUTOSYNC_MAX_SWAP_USED_MB=512
CHRONOS_AUTOSYNC_DEFER_SECONDS=90

# Opt in only if you want dashboard stats to paginate the entire Plaud cloud library.
CHRONOS_STATS_ENABLE_PLAUD_CLOUD=0

# Gemini API settings (optional)
# GEMINI_API_VERSION=v1beta
# CHRONOS_ALLOW_PAID_GEMINI_FALLBACK=0

# Notion (optional - enables direct Notion sync)
# NOTION_TOKEN=your_notion_token_here
# NOTION_DATABASE_ID=your_notion_database_id_here
# NOTION_CLIENT_ID=your_notion_client_id_here
# NOTION_CLIENT_SECRET=your_notion_client_secret_here
# NOTION_REDIRECT_URI=http://localhost:8000/api/v1/auth/notion/callback

# === SECURITY & TUNNEL CONFIGURATION ===
# Shared API key for client-server auth (e.g. for PlaudBlenderiOS)
# CHRONOS_API_KEY=your_chronos_api_key_here

# Enforce authentication (raise 401 if CHRONOS_API_KEY is empty/missing).
# Strongly recommended for any shared deployment.
# CHRONOS_REQUIRE_AUTH=1

# Local custom ngrok domain configuration (used by launch scripts)
# CHRONOS_NGROK_DOMAIN=your-ngrok-domain.ngrok-free.dev

# Local custom ngrok authtoken configuration (used by pi-remote-access.sh)
# NGROK_AUTHTOKEN=your_ngrok_authtoken_here
