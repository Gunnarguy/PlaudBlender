{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run: Chronos UI (Dash)",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python",
      "args": ["scripts/launch_app.py"],
      "problemMatcher": [],
      "isBackground": true,
      "group": "build"
    },
    {
      "label": "Run: Full Pipeline",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python",
      "args": ["scripts/chronos_pipeline.py", "--full"],
      "problemMatcher": []
    },
    {
      "label": "Test: pytest (quick)",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python",
      "args": ["-m", "pytest", "tests", "-q"],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Test: pytest (verbose)",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python",
      "args": ["-m", "pytest", "tests", "-v", "--tb=short"],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Run: MCP server",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python",
      "args": ["scripts/mcp_server.py"],
      "problemMatcher": []
    },
    {
      "label": "Run: Auto-Sync",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python",
      "args": ["scripts/auto_sync.py"],
      "problemMatcher": [],
      "isBackground": true
    }
  ]
}
