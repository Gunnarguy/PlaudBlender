[Unit]
Description=Chronos REST API (FastAPI)
After=network-online.target chronos-qdrant.service
Wants=chronos-qdrant.service

[Service]
Type=simple
User=gunnarhostetler
WorkingDirectory=/home/gunnarhostetler/PlaudBlender
Environment=HOME=/home/gunnarhostetler
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/gunnarhostetler/PlaudBlender/venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/gunnarhostetler/PlaudBlender/.env
ExecStart=/home/gunnarhostetler/PlaudBlender/venv/bin/python scripts/launch_api.py
Restart=always
RestartSec=5
StandardOutput=append:/home/gunnarhostetler/PlaudBlender/logs/api.log
StandardError=append:/home/gunnarhostetler/PlaudBlender/logs/api.log

[Install]
WantedBy=multi-user.target
