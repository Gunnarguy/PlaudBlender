[Unit]
Description=Chronos Full Pipeline Sync
After=chronos-qdrant.service

[Service]
Type=oneshot
User=your-pi-username
WorkingDirectory=/home/your-pi-username/PlaudBlender
Environment=HOME=/home/your-pi-username
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/your-pi-username/PlaudBlender/venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/your-pi-username/PlaudBlender/.env
ExecStart=/home/your-pi-username/PlaudBlender/venv/bin/python scripts/chronos_pipeline.py --full
# A run that extracts a new batch of entities took 14.5 min on 2026-10-01; 900 s killed one.
TimeoutStartSec=3600
MemoryHigh=900M
MemoryMax=1300M
CPUQuota=125%
TasksMax=120
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
OOMScoreAdjust=300
StandardOutput=append:/home/your-pi-username/PlaudBlender/logs/pipeline.log
StandardError=append:/home/your-pi-username/PlaudBlender/logs/pipeline.log
