[Unit]
Description=Chronos Web UI (Dash)
After=network-online.target chronos-qdrant.service
Wants=chronos-qdrant.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=your-pi-username
WorkingDirectory=/home/your-pi-username/PlaudBlender
Environment=HOME=/home/your-pi-username
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/your-pi-username/PlaudBlender/venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/your-pi-username/PlaudBlender/.env
ExecStart=/home/your-pi-username/PlaudBlender/venv/bin/python scripts/launch_app.py
Restart=always
RestartSec=10
MemoryHigh=384M
MemoryMax=640M
CPUQuota=80%
TasksMax=80
OOMScoreAdjust=200
StandardOutput=append:/home/your-pi-username/PlaudBlender/logs/ui.log
StandardError=append:/home/your-pi-username/PlaudBlender/logs/ui.log

[Install]
WantedBy=multi-user.target
